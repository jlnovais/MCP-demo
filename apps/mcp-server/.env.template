PORT=4000
MCP_SERVER_API_KEY=1234567890

# Wallet API (upstream)
WALLET_API_BASE_URL=http://localhost:4000
WALLET_API_KEY=your-wallet-api-key

# RAG / knowledge base
# Voyage AI embeddings (https://docs.voyageai.com) - required for search_knowledge_base
VOYAGE_API_KEY=your-voyage-api-key
VOYAGE_EMBED_MODEL=voyage-4

# Vector store backend: postgres | lancedb (default: postgres)
VECTOR_STORE=postgres

# Ingest chunkers: sentence | markdown | html
# sentence = SentenceSplitter (512 / 64); markdown = MarkdownNodeParser (# / ##)
# html = HTMLNodeParser (strip tags). Empty type keys inherit CHUNKER.
# CLI override for all files: --chunker markdown
CHUNKER=sentence
CHUNKER_TEXT=sentence
CHUNKER_HTML=html
CHUNKER_MARKDOWN=markdown
CHUNKER_PDF=sentence

# Postgres + pgvector (used when VECTOR_STORE=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=mcp_knowledge
POSTGRES_TABLE=knowledge_chunks

# LanceDB (used when VECTOR_STORE=lancedb)
LANCEDB_PATH=data/lancedb
LANCEDB_TABLE=knowledge
